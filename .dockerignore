# Do not let host-installed dependencies overwrite the lockfile-installed
# dependencies in Docker build stages. Native packages such as esbuild must
# always be installed for the image platform.
**/node_modules
front/node_modules

# Development-only local state is not part of application build contexts.
**/.venv
backend/.venv
**/__pycache__
backend/.pytest_cache
.test-tmp
**/.test-tmp*
**/.codex-test-tmp
.uv-cache
**/.codegraph
.git
**/.env
backups/

# Browser sessions, credentials and local generation evidence stay on Windows.
local-browser/
